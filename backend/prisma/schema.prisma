generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  CHURNED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum NotificationType {
  INFO
  TASK
  TASK_ASSIGNED
  PROJECT
  INVOICE
  SYSTEM
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  COMMENT
}

enum InviteType {
  EMAIL
  PUBLIC_CODE
  TEMP_ACCOUNT
  LINK
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model Role {
  teamId String? @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  teamInvites  TeamInvite[]
  @@unique([teamId, name])
}

model CustomPermission {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id          String   @id @default(uuid()) @db.Uuid
  slug        String
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([teamId, slug])
}

model Department {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentHierarchy")
  users        User[]
  teamInvites  TeamInvite[]
  @@unique([teamId, name])
}

model User {
  teamId String? @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  publicCode       String   @unique
  isActive         Boolean  @default(true)
  roleId           String   @db.Uuid
  departmentId     String?  @db.Uuid
  managerId        String?  @db.Uuid
  extraPermissions Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  role              Role              @relation(fields: [roleId], references: [id])
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager           User?             @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     User[]            @relation("UserHierarchy")
  projectMembers    ProjectMember[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  taskComments      TaskComment[]
  taskAttachments   TaskAttachment[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  refreshTokens     RefreshToken[]
  invitesCreated    TeamInvite[]      @relation("InviteCreator")
  inviteProvisioned TeamInvite?       @relation("InviteProvisionedUser")

  @@index([departmentId])
  @@index([managerId])
  @@index([roleId])
  @@index([publicCode])
}

model TeamInvite {
  codeHash String? @unique
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id                 String       @id @default(uuid()) @db.Uuid
  type               InviteType
  status             InviteStatus @default(PENDING)
  email              String?
  targetPublicCode   String?
  tokenHash          String?      @unique
  roleId             String?      @db.Uuid
  departmentId       String?      @db.Uuid
  extraPermissions   Json         @default("[]")
  expiresAt          DateTime
  createdById        String       @db.Uuid
  provisionedUserId  String?      @unique @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  createdBy        User        @relation("InviteCreator", fields: [createdById], references: [id])
  provisionedUser  User?       @relation("InviteProvisionedUser", fields: [provisionedUserId], references: [id], onDelete: SetNull)
  role             Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([targetPublicCode])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id           String       @id @default(uuid()) @db.Uuid
  companyName  String
  contactName  String?
  email        String?
  phone        String?
  status       ClientStatus @default(LEAD)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  projects Project[]
  invoices Invoice[]

  @@index([status])
  @@index([email])
}

model Project {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String         @db.Uuid
  name        String
  description String?
  status      ProjectStatus  @default(PLANNING)
  priority    TaskPriority   @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?       @db.Decimal(14, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  members  ProjectMember[]
  tasks    Task[]
  invoices Invoice[]

  @@index([clientId, status])
  @@index([teamId, status, endDate])
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  assigneeId  String?      @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  uploadedById String   @db.Uuid
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Invoice {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String
  clientId      String        @db.Uuid
  projectId     String?       @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(DRAFT)
  paidAt        DateTime?
  issuedAt      DateTime?
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([projectId])
  @@unique([teamId, invoiceNumber])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType @default(INFO)
  title      String
  body       String?
  readAt     DateTime?
  entityType String?
  entityId   String?          @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt, id])
}

model ActivityLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @db.Uuid
  action     ActivityAction
  entityType String
  entityId   String?        @db.Uuid
  metadata   Json?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// Shared team workspace; external mail delivery is deliberately not simulated.
model WorkspaceItem {
  teamId String @default(dbgenerated("'11111111-1111-4111-8111-111111111111'::uuid")) @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([teamId])
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  title     String
  body      String   @default("") @db.Text
  status    String   @default("DRAFT")
  ownerId   String   @db.Uuid
  runs      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
}

model Team {
 id String @id @default(uuid()) @db.Uuid
 name String
 createdAt DateTime @default(now())

  roles Role[]
  customPermissions CustomPermission[]
  departments Department[]
  users User[]
  invites TeamInvite[]
  clients Client[]
  projects Project[]
  tasks Task[]
  invoices Invoice[]
  workspaceItems WorkspaceItem[]
}
