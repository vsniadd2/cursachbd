# PostgreSQL + API (docker compose up)
POSTGRES_USER=flexora
POSTGRES_PASSWORD=flexora_secret
POSTGRES_DB=flexora
POSTGRES_PORT=5432
API_PORT=3001

JWT_SECRET=change-me-to-a-long-random-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
